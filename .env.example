# Copy to `.env` and fill in. `server/env.ts` validates these at boot and
# throws with the names of anything missing — never the values.

# Neon Postgres connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Comma-separated EXACT origins, matched by equality and never by suffix —
# anyone can deploy to *.vercel.app. Preview deployments get their own value.
APP_ORIGINS=http://localhost:5173

# Cloudflare R2 (Project B). Blank until Task 15.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
