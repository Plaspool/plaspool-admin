# Copy to `.env` and fill in. `server/env.ts` validates these at boot and
# throws with the names of anything missing — never the values.

# Neon Postgres connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Comma-separated EXACT origins, matched by equality and never by suffix —
# anyone can deploy to *.vercel.app. Preview deployments get their own value.
APP_ORIGINS=http://localhost:5173

# Outbound mail, for the password-reset flow. Blank is legal: the app boots and
# serves everything else, and `POST /api/auth/forgot` answers 501 for EVERY
# address alike rather than only for addresses that have an account.
#   RESEND_API_KEY — `re_…`, from resend.com. Never commit a value here.
#   MAIL_FROM      — a verified sender, e.g. `Studio <studio@example.com>`.
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare R2 (Project B). Blank until Task 15.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Commerce ────────────────────────────────────────────────────────────────
# NOT validated by `server/env.ts`. Each of these is read lazily by the
# subsystem that needs it, so a deployment missing them still boots and still
# serves the blog and the catalog — only the specific path fails. That is
# deliberate; see `server/shop/payments/config.ts`.

# Paystack SECRET key: `sk_test_…` locally, `sk_live_…` in production. The
# `sk_` prefix is enforced — the `pk_…` key from the frontend snippets produces
# a 401 on the first charge and a signature that never verifies.
#
# THIS ONE VALUE IS ALSO THE WEBHOOK SIGNING KEY. Paystack has no separate
# signing secret; `x-paystack-signature` is an HMAC-SHA512 under this. Rotating
# it takes effect for verification immediately, and any redelivery still inside
# Paystack's 72-hour retry window that was signed under the old key will be
# refused. Absent, every payment attempt fails and every webhook 401s.
PAYSTACK_SECRET_KEY=

# Where the customer lands after paying. A UI hint ONLY — the browser arriving
# there proves nothing, and the route re-asks the provider. Optional.
PAYMENTS_CALLBACK_URL=

# Vercel sends `Authorization: Bearer <this>` on a cron invocation, and sends
# NOTHING if the project has no such variable. The cart maintenance endpoint in
# `vercel.json` fails CLOSED: absent, it 401s every night, expired holds are
# never released and reserved stock leaks. At least 16 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ── Delivery couriers (server/shop/logistics/config.ts) ─────────────────────
# Both couriers are OFF until their keys exist, and each base URL defaults to
# the SANDBOX — a forgotten variable can never book a real courier. Set a live
# host only on production, on purpose.
#   Fez: portal → Developers → Manage Keys. FEZ_SECRET_KEY also signs the
#   webhooks Fez sends back, so webhook verification needs it even though
#   booking works without it.
FEZ_USER_ID=
FEZ_PASSWORD=
FEZ_SECRET_KEY=
# FEZ_BASE_URL=https://api.fezdelivery.co/v1
#   Terminal: dashboard → Settings → API keys. The secret key also signs webhooks.
TERMINAL_SECRET_KEY=
# TERMINAL_BASE_URL=https://api.terminal.africa/v1
